    "next": "16.4.2",
    "node-html-parser": "^9.0.4",
    "nodemailer": "10.1.4",
    "pdf-lib": "1.17.1",
    "postgres": "^3.4.9",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "robots-parser": "^3.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
